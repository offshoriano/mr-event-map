# MR Group: domínio principal é mrgroup.com.br
RewriteEngine On

# Endereço antigo (mreventmap.com.br) e www vão para mrgroup.com.br, mantendo o caminho.
# A agenda continua na raiz, então mreventmap.com.br/vagas cai em mrgroup.com.br/vagas.
RewriteCond %{HTTP_HOST} ^(www\.)?mreventmap\.com\.br$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.mrgroup\.com\.br$ [NC]
RewriteRule ^(.*)$ https://mrgroup.com.br/$1 [R=301,L]

# Sempre HTTPS (o CDN da Hostinger informa o protocolo original nesse cabeçalho)
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://mrgroup.com.br/$1 [R=301,L]

# Página própria para endereço que não existe
ErrorDocument 404 /404.html

# Radar Offshore em /radar (os arquivos continuam na pasta anp/)
RewriteRule ^radar$ /radar/ [R=301,L]
RewriteRule ^radar/(.*)$ anp/$1 [L]

# Velocidade: compressão e cache no navegador (imagens e fontes por 30 dias; páginas, dados e scripts sempre conferidos, para a agenda nova aparecer na hora)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Scripts sempre conferidos com o servidor (resposta 304 rápida quando nada mudou), para a agenda nova aparecer na hora
<IfModule mod_headers.c>
  <FilesMatch "\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# /anp/ é o mesmo conteúdo de /radar/: manda para o endereço oficial para o Google não ver página duplicada
RewriteCond %{THE_REQUEST} \s/anp/?(\s|\?) [NC]
RewriteRule ^anp/?$ /radar/ [R=301,L]

# Segurança: cabeçalhos que dizem ao navegador para não aceitar truques comuns
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>

# Arquivos internos que não devem ser baixados por ninguém
<FilesMatch "\.(md|py|lock|tmp|log|sh|yml|yaml)$">
  Require all denied
</FilesMatch>
