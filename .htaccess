# MR Group: domínio principal é mrgroup.com.br
RewriteEngine On

# Endereço antigo (mreventmap.com.br) e www vão para mrgroup.com.br, mantendo o caminho.
# A agenda continua na raiz, então mreventmap.com.br/vagas cai em mrgroup.com.br/vagas.
RewriteCond %{HTTP_HOST} ^(www\.)?mreventmap\.com\.br$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.mrgroup\.com\.br$ [NC]
RewriteRule ^(.*)$ https://mrgroup.com.br/$1 [R=301,L]

# Radar Offshore em /radar (os arquivos continuam na pasta anp/)
RewriteRule ^radar$ /radar/ [R=301,L]
RewriteRule ^radar/(.*)$ anp/$1 [L]

# Velocidade: compressão e cache no navegador (imagens e fontes por 30 dias; dados de vagas e páginas sempre conferidos)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# /anp/ é o mesmo conteúdo de /radar/: manda para o endereço oficial para o Google não ver página duplicada
RewriteCond %{THE_REQUEST} \s/anp/?(\s|\?) [NC]
RewriteRule ^anp/?$ /radar/ [R=301,L]
